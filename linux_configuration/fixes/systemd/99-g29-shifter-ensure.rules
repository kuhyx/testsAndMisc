# Run the safety-net unit whenever the G29 is (re)enumerated, so a hotplug is
# covered as well as boot. Matches the native PID (C24F, PS3 selector) AND the
# PS4-mode PID (C260) so a wheel powered on in the wrong mode is reported at
# once instead of silently falling back to the firmware's bad 1st/3rd decode.
# Installed by fixes/fix_g29_shifter.sh.
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0003g*v0000046Dp0000C24F|hid:b0003g*v0000046Dp0000C260", TAG+="systemd", ENV{SYSTEMD_WANTS}+="g29-shifter-bpf.service"
