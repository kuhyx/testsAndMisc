[cpu_monitor]
command=~/.config/i3blocks/cpu_monitor.sh
interval=10
markup=pango


[gpu_monitor]
command=~/.config/i3blocks/gpu_monitor.sh
interval=persist
markup=pango


[motherboard_temperature]
command=~/.config/i3blocks/motherboard_temp.sh
interval=30
markup=pango


[memory]
command=~/.config/i3blocks/memory.sh
interval=30
color=#50FA7B


[disk]
command=~/.config/i3blocks/disk.sh
interval=60
color=#50FA7B


[volume]
command=~/.config/i3blocks/volume.sh
interval=persist
markup=pango


[ethernet]
command=~/.config/i3blocks/ethernet.sh
interval=persist
color=#FFFFFF


[claude_usage]
command=~/.config/i3blocks/claude_usage.sh
interval=60


[pc_startup]
command=~/.config/i3blocks/pc_startup_status.sh
interval=30
color=#FFFFFF

[screen_locker]
command=~/.config/i3blocks/screen_locker.sh
interval=30

[book_guard]
command=~/.config/i3blocks/book_guard.sh
interval=30

[tutor]
command=~/.config/i3blocks/tutor.sh
interval=30

# Active focus project. signal=11: daily-limits sends `pkill -RTMIN+11 -x
# i3blocks` the moment the focus status changes; 30 s is only the fallback.
[focus_project]
command=~/.config/i3blocks/focus_project.sh
interval=30
signal=11

[issue_dashboard]
command=~/.config/i3blocks/issue_dashboard.sh
interval=30

[shutdown_countdown]
command=~/.config/i3blocks/shutdown_countdown.sh
interval=60
markup=pango


# Red dot while game-rec records. signal=12: game-rec sends `pkill -RTMIN+12
# -x i3blocks` on start/stop/recorder exit; no polling at all.
[game_rec]
command=~/.config/i3blocks/game_rec.sh
interval=once
signal=12


[time]
command=~/.config/i3blocks/time.sh
interval=persist
color=#50FA7B
