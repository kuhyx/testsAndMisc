[cpu_monitor]
command=~/.config/i3blocks/cpu_monitor.sh
interval=10
markup=pango


[gpu_monitor]
command=~/.config/i3blocks/gpu_monitor.sh
interval=persist
markup=pango


[motherboard_temperature]
command=~/.config/i3blocks/motherboard_temp.sh
interval=30
markup=pango


[memory]
command=~/.config/i3blocks/memory.sh
interval=30
color=#50FA7B


[disk]
command=~/.config/i3blocks/disk.sh
interval=60
color=#50FA7B


[volume]
command=~/.config/i3blocks/volume.sh
interval=persist
markup=pango


[ethernet]
command=~/.config/i3blocks/ethernet.sh
interval=persist
color=#FFFFFF


[claude_usage]
command=~/.config/i3blocks/claude_usage.sh
interval=60


[pc_startup]
command=~/.config/i3blocks/pc_startup_status.sh
interval=30
color=#FFFFFF


[screen_locker]
command=~/.config/i3blocks/screen_locker.sh
interval=30

[shutdown_countdown]
command=~/.config/i3blocks/shutdown_countdown.sh
interval=60
markup=pango


[time]
command=~/.config/i3blocks/time.sh
interval=persist
color=#50FA7B
