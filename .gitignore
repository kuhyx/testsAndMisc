# ci_mirror.sh cached requirements.txt venv (rebuilt on demand)
.ci-mirror-venv/

# Locally built Arch packages. The PKGBUILD and installer script are the source
# and stay tracked; the built artifact is a ~600 MB binary that must never be
# committed (see memories/binary-files.md).
linux_configuration/*/*.pkg.tar.zst
linux_configuration/*/*.pkg.tar.xz

# Wine/Bottles prefixes — local runtime state, not source.
bottles/

# archwiki_rag local vector index: regenerated by `reindex`, machine-specific,
# and full of binary sqlite/parquet blobs.

# ===========================================================================
# billsplit (Flutter) — launcher icons & platform assets MUST live in-repo
# ===========================================================================
# The blanket *.png / *.ico / *.manifest rules above would swallow the whole
# platform icon set, leaving a checkout that cannot `flutter build`. These are
# generated build inputs, not stray binaries, so they get the documented
# .binary-allowlist exception rather than the ../testsAndMisc_binaries/ +
# symlink treatment (a symlinked PNG breaks a fresh clone).
# Last-match-wins: this block sits at the end of the file on purpose, so it
# also overrides *.manifest in the PyInstaller section.
# Source art for the shared icon generator (python_pkg/app_icons). Both the
# SVG and the rasterised PNG are kept so regenerating never needs rsvg-convert.
!billsplit/assets/icon/*.svg
!billsplit/assets/icon/*.png
# Android: legacy mipmaps plus the adaptive foreground/monochrome layers that
# flutter_launcher_icons writes into drawable-*/.
!billsplit/android/app/src/main/res/**/*.png
# Android is the only platform target this repo ships. The ios/macos/windows/
# linux runner dirs were unused `flutter create` scaffolding (96 tracked files,
# nothing built them - billsplit-ci.yml runs analyze/test only) and were
# removed. Ignore them so a stray `flutter create` cannot silently reintroduce
# them as tracked files; regenerate locally when a platform is actually wanted.
billsplit/ios/
billsplit/macos/
billsplit/windows/
billsplit/linux/

# TypeScript incremental build cache - generated, never useful in a diff.
*.tsbuildinfo
# CocoIndex Code (ccc)
/.cocoindex_code/

# Endurain: generated secrets (SECRET_KEY, FERNET_KEY, DB password) and the
# importer's API key + dedupe ledger. Never commit.
endurain/.env
endurain/.api_key
endurain/state/
